# Copie este archivo como .env y complete los datos de su PostgreSQL local.
# .env está en .gitignore: nunca se sube al repositorio.
#
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Agregue la contraseña de su usuario después de "postgres:" (sin espacios).
DATABASE_URL=postgresql://postgres@localhost:5432/programatss

# Puerto de la API (opcional, por defecto 4000; el proxy de Vite apunta a 4000)
PORT=4000

# Secreto para firmar la cookie de sesión (obligatorio, al menos 32 caracteres al azar).
# Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
